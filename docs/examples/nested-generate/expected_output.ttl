PREFIX iter:   <http://w3id.org/sparql-generate/iter/>
PREFIX schema: <http://schema.org/>

<http://example.org/skill/compilers>
        schema:name  "compilers" .

<http://example.org/skill/cryptanalysis>
        schema:name  "cryptanalysis" .

<http://example.org/skill/computing>
        schema:name  "computing" .

<http://example.org/person/1>
        a                  schema:Person;
        schema:knowsAbout  <http://example.org/skill/programming> , <http://example.org/skill/mathematics>;
        schema:name        "Ada Lovelace" .

<http://example.org/person/3>
        a                  schema:Person;
        schema:knowsAbout  <http://example.org/skill/compilers> , <http://example.org/skill/programming>;
        schema:name        "Grace Hopper" .

<http://example.org/skill/programming>
        schema:name  "programming" .

<http://example.org/skill/mathematics>
        schema:name  "mathematics" .

<http://example.org/person/2>
        a                  schema:Person;
        schema:knowsAbout  <http://example.org/skill/computing> , <http://example.org/skill/cryptanalysis> , <http://example.org/skill/mathematics>;
        schema:name        "Alan Turing" .
