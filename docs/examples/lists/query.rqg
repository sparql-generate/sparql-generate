PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX schema: <http://schema.org/>
BASE <http://example.org/>

GENERATE {
  <people> a schema:ItemList ;
    schema:itemListElement LIST( <person/{?id}> ) .
}
ITERATOR iter:CSV(<http://example.org/people.csv>, "id", "born") AS ?id ?born
ORDER BY ?born
