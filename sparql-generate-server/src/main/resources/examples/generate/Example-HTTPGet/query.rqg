BASE <http://example.com/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX fun: <http://w3id.org/sparql-generate/fn/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ex: <http://example.com/>

GENERATE {
  [] a ex:Report ;
    ex:station ?name ;
    ex:airQualityIndex ?aqi ;
    ex:reportedAt ?time .
}
ITERATOR iter:HTTPGet(<https://ci.mines-stetienne.fr/aqi/static/station/1>, 2, 3) AS ?report
WHERE {
  BIND(fun:JSONPath(?report, "$.data.city.name") AS ?name)
  BIND(xsd:integer(fun:JSONPath(?report, "$.data.aqi")) AS ?aqi)
  BIND(fun:JSONPath(?report, "$.data.time.s") AS ?time)
}
